{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!!dist",
      "!!node_modules",
      "!!backend-whisper",
      "!!public",
      "!package-lock.json",
      // Generated by the i18n tooling; formatting them by hand would churn every PR.
      "!src/client/locales/**",
      // Tailwind 4 syntax (@theme, @utility) is not CSS Biome can parse yet.
      "!src/client/index.css",
      // Hand-written ES5 that runs before the bundle; the linter's ES module rules do not apply.
      "!index.html"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "json": { "formatter": { "trailingCommas": "none" } },
  "assist": { "actions": { "source": { "organizeImports": "off" } } },
  "linter": {
    "enabled": true,
    "domains": { "react": "recommended" },
    "rules": {
      "preset": "recommended",
      "a11y": {
        "preset": "recommended",
        // The virtualised jobs table is a grid of divs with table roles: a real
        // <table> cannot be windowed. Status chips, radio groups and lists use
        // ARIA roles where no element carries the same meaning.
        "useSemanticElements": "off",
        // Rows and column headers of that table are structural, not widgets.
        "useFocusableInteractive": "off",
        // Labels wrap the kit's Select/TextArea/Checkbox components; the rule
        // cannot see through a component to the control it renders.
        "noLabelWithoutControl": "off"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noArrayIndexKey": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useTemplate": "off",
        "noParameterAssign": "off"
      },
      "complexity": {
        "noForEach": "off",
        "useLiteralKeys": "off"
      }
    }
  },
  "overrides": [
    {
      // Tests stub fetch and poke at private state; `any` is the honest type there.
      "includes": ["**/*.test.ts", "**/*.test.tsx", "src/client/test-render.tsx"],
      "linter": { "rules": { "suspicious": { "noExplicitAny": "off" } } }
    }
  ]
}
