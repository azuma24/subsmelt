{
  "name": "subsmelt",
  "version": "0.6.6",
  "type": "module",
  "description": "Self-hosted batch subtitle translator using LLM",
  "license": "MIT",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "concurrently \"tsx watch src/server/index.ts\" \"vite\"",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.build.json",
    "start": "node dist/server/index.js",
    "test": "tsx --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "lint": "npm run typecheck"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.81",
    "@ai-sdk/google": "^3.0.80",
    "@ai-sdk/openai": "^3.0.68",
    "@ai-sdk/openai-compatible": "^1.0.17",
    "@tanstack/react-query": "^5.96.2",
    "@tanstack/react-virtual": "^3.14.2",
    "ai": "^6.0.198",
    "ass-parser": "^0.2.0",
    "ass-stringify": "^0.1.3",
    "better-sqlite3": "13.0.3",
    "chokidar": "^5.0.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "franc-min": "^6.2.0",
    "i18next": "^26.0.3",
    "i18next-browser-languagedetector": "^8.2.1",
    "iconv-lite": "^0.7.2",
    "jschardet": "^4.0.0",
    "jszip": "^3.10.1",
    "react-i18next": "^17.0.2",
    "react-router-dom": "^7.18.1",
    "subtitle": "^4.2.1",
    "tiny-async-pool": "^2.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/tiny-async-pool": "^2.0.3",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "postcss": "^8.4.49",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
